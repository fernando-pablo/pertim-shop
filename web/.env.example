# Usado só quando a vitrine roda FORA do Docker (npm run dev).
# Copie para "web/.env". Os dois apontam para a API.

# Endereço da API para o servidor da vitrine
API_URL=http://localhost:3333
# Endereço da API para o navegador do cliente (envio do pedido)
PUBLIC_API_URL=http://localhost:3333
# WhatsApp do botão "Quero um sistema assim", com DDD (vazio = portfólio)
CONTACT_WHATSAPP=
