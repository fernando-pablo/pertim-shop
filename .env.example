# Configurações do banco de dados usado no Docker.
#
# Não é obrigatório: sem um arquivo .env, o docker compose usa estes mesmos
# valores automaticamente. Para trocar, copie este arquivo com o nome ".env"
# e altere os valores. O .env nunca vai para o GitHub (está no .gitignore).

POSTGRES_USER=pertim
POSTGRES_PASSWORD=pertim
POSTGRES_DB=pertim

# Senha dos lojistas das lojas de demonstração
DEMO_PASSWORD=pertim-demo

# De quantas em quantas horas as lojas de demonstração voltam ao original (0 desliga)
DEMO_RESET_HOURS=24

# Chave que assina o login dos lojistas (JWT). Em produção, use uma chave longa e secreta.
JWT_SECRET=troque-este-segredo-em-producao

# Cache da vitrine no Redis ("false" desliga, para comparar a velocidade)
CACHE_ENABLED=true

# Endereço da API que o navegador do cliente usa para enviar o pedido
PUBLIC_API_URL=http://localhost:3333

# WhatsApp do botão "Quero um sistema assim", com DDD (ex.: 11912345678).
# Fica só no seu .env, que não vai para o GitHub. Vazio: o botão leva ao portfólio.
CONTACT_WHATSAPP=
