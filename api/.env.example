# Usado só quando a API roda FORA do Docker (npm run start:dev, comandos do Prisma).
# Copie para "api/.env". Os endereços apontam para o banco e o Redis do Docker.
DATABASE_URL=postgresql://pertim:pertim@localhost:5433/pertim
REDIS_URL=redis://localhost:6379
PORT=3333

# Senha dos lojistas das lojas de demonstração
DEMO_PASSWORD=pertim-demo
