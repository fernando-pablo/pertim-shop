# Usado só quando a API roda FORA do Docker (npm run start:dev, comandos do Prisma).
# Copie para "api/.env". Os endereços apontam para o banco e o Redis do Docker.
DATABASE_URL=postgresql://pertim:pertim@localhost:5433/pertim
REDIS_URL=redis://localhost:6379
PORT=3333

# Chave que assina o login dos lojistas (JWT)
JWT_SECRET=troque-este-segredo-em-producao
# Tempo até o login expirar
JWT_EXPIRES_IN=8h

# Senha dos lojistas das lojas de demonstração
DEMO_PASSWORD=pertim-demo

# Cache da vitrine no Redis ("false" desliga, para comparar a velocidade)
CACHE_ENABLED=true
# Sites que podem chamar a API pelo navegador, separados por vírgula.
# Vazio libera todos (bom no PC). Na hospedagem: o endereço da vitrine.
CORS_ORIGINS=

# Quantos intermediários (proxies) a hospedagem coloca antes da API.
# No seu PC é 0. Serve para o limite de tentativas enxergar o IP certo.
TRUST_PROXY_HOPS=0
